FLASK_APP=wsgi:app
FLASK_CONFIG=production
SECRET_KEY=
IDENTITY_HMAC_KEY=
# PENDING: internal Coolify connection URLs, with URL-encoded credentials.
# mariadb+mariadbconnector://USER:PASSWORD@INTERNAL_MARIADB:3306/DATABASE
DATABASE_URL=
# redis://:PASSWORD@INTERNAL_REDIS:6379/0 (rediss:// when using TLS)
REDIS_URL=
# Public HTTPS origin, without a final slash or /participar path.
FRONTEND_URL=https://uypolls.online
CORS_ORIGINS=https://uypolls.online
# Public frontend, public backend, and hosts used by internal health checks.
TRUSTED_HOSTS=uypolls.online,mapi.uypolls.online,localhost,127.0.0.1
# Number of trusted reverse proxy hops that set X-Forwarded-For/Proto.
# Use 1 for the supplied nginx proxy which overwrites those headers.
TRUSTED_PROXY_COUNT=1
# PENDING: administrative SMTP, required before production startup.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
SURVEY_ID=lavalleja-2026
SURVEY_TOKEN_TTL_SECONDS=86400
SURVEY_ENFORCE_IP_UNIQUENESS=false
# Shared connections are rate-limited, not permanently excluded.
SURVEY_LINK_IP_LIMIT=120 per hour;1000 per day
SURVEY_CHALLENGE_IP_LIMIT=120 per hour;1000 per day
SURVEY_RESPONSE_IP_LIMIT=120 per hour;1000 per day
# Optional stable namespace if sharing Redis with another deployment; do not rotate to bypass limits.
RATELIMIT_KEY_PREFIX=
# Local one-use number verifier is mandatory; production minimum fill time in seconds.
SURVEY_MIN_FILL_SECONDS=15
# Optional additional third-party antibot service; leave disabled for self-contained operation.
TURNSTILE_REQUIRED=false
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=uypolls.online
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Enable only for a single initial instance; then run migrations as release job.
RUN_MIGRATIONS=true
